# Local terraform directories (holds binaries and plugins)
.terraform/

# Distributed state files / backups (contains sensitive architecture data)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Override local configuration files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files containing actual secret keys/passwords
*.tfvars
*.tfvars.json

# Ignore local CLI config files
.terraformrc
terraform.rc

# Private spike/evidence artifacts
SPIKE_NOTES.md
fixtures/sample-finding-event.json
*.zip

# JetBrains / PyCharm
.idea/
